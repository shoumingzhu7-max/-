Set fso = Nothing

Function DecodeBase64(s)
  Dim xml, node, bytes
  Set xml = CreateObject("MSXML2.DOMDocument")
  Set node = xml.createElement("b64")
  node.dataType = "bin.base64"
  node.text = s
  bytes = node.nodeTypedValue
  DecodeBase64 = BytesToString(bytes)
  Set node = Nothing
  Set xml = Nothing
End Function

Function BytesToString(bytes)
  Dim st
  Set st = CreateObject("ADODB.Stream")
  st.Type = 1
  st.Open
  st.Write bytes
  st.Position = 0
  st.Type = 2
  st.Charset = "utf-8"
  BytesToString = st.ReadText
  st.Close
  Set st = Nothing
End Function
